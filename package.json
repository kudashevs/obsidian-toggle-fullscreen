{
  "name": "obsidian-toggle-fullscreen",
  "version": "1.3.0",
  "description": "This plugin shows a single document in the fullscreen focus mode",
  "license": "MIT",
  "type": "module",
  "main": "main.js",
  "homepage": "https://github.com/kudashevs/obsidian-toggle-fullscreen",
  "bugs": "https://github.com/kudashevs/obsidian-toggle-fullscreen/issues",
  "keywords": [
    "obsidian",
    "obsidian fullscreen",
    "obsidian fullscreen mode",
    "obsidian toggle fullscreen"
  ],
  "authors": [
    {
      "name": "Sergey Kudashev",
      "email": "kudashevs@gmail.com"
    }
  ],
  "devDependencies": {
    "@wdio/cli": "^10.2.0",
    "@wdio/local-runner": "^10.2.0",
    "@wdio/mocha-framework": "^10.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.6.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "obsidian": "1.1.1",
    "prettier": "^3.10.1",
    "tslib": "^2.9.1",
    "typescript": "^4.7.2||^5.8.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1",
    "wdio-obsidian-service": "^3.5.0",
    "webdriverio": "^10.2.0"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "test:unit": "vitest run test ./tests/unit",
    "test:e2e": "wdio run tests/acceptance/wdio.conf.mts",
    "lint": "eslint --config eslint.config.mts .",
    "lint:fix": "eslint --config eslint.config.mts . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "tsc",
    "lock": "npm install --package-lock-only"
  }
}
