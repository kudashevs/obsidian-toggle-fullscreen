{
  "compilerOptions": {
    "target": "ES2018",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "node",
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "inlineSourceMap": true,
    "inlineSources": true,
    "lib": [
      "dom",
      "ES2018"
    ]
  },
  "include": [ "*.ts" ],
  "exclude": [ "build", "tests", "node_modules" ]
}
